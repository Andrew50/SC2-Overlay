{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc2-overlay.local/schemas/build.schema.json",
  "$ref": "#/$defs/compactBuildFile",
  "$defs": {
    "compactBuildFile": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9_.-]+$"
      },
      "patternProperties": {
        "^[a-zA-Z0-9_.-]+$": { "$ref": "#/$defs/compactBranchEntry" }
      },
      "additionalProperties": false
    },
    "compactBranchEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/compactStepEntry" }
        }
      },
      "oneOf": [{ "required": ["steps"] }, { "required": ["target"] }]
    },
    "compactStepEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time": { "type": "string" },
        "supply": { "type": "number" },
        "action": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" },
        "decision": { "$ref": "#/$defs/compactDecisionEntry" }
      },
      "anyOf": [{ "required": ["action"] }, { "required": ["decision"] }]
    },
    "compactDecisionEntry": {
      "type": "object",
      "required": ["1", "2"],
      "additionalProperties": false,
      "properties": {
        "1": { "$ref": "#/$defs/decisionBranch" },
        "2": { "$ref": "#/$defs/decisionBranch" },
        "3": { "$ref": "#/$defs/decisionBranch" }
      }
    },
    "decisionBranch": {
      "type": "object",
      "required": ["label", "target"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    }
  }
}
