{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sc2-overlay.local/schemas/config.schema.json",
  "type": "object",
  "required": ["window", "hotkeys", "timer", "ui", "data"],
  "additionalProperties": false,
  "properties": {
    "window": {
      "type": "object",
      "required": [
        "width",
        "height",
        "minWidth",
        "minHeight",
        "opacity",
        "alwaysOnTop",
        "transparent",
        "frame",
        "clickThrough"
      ],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "minimum": 200 },
        "height": { "type": "number", "minimum": 120 },
        "minWidth": { "type": "number", "minimum": 100 },
        "minHeight": { "type": "number", "minimum": 100 },
        "monitor": { "type": "integer", "minimum": 1 },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "opacity": { "type": "number", "minimum": 0.1, "maximum": 1 },
        "alwaysOnTop": { "type": "boolean" },
        "transparent": { "type": "boolean" },
        "frame": { "type": "boolean" },
        "clickThrough": { "type": "boolean" }
      }
    },
    "hotkeys": {
      "type": "object",
      "required": ["globalEnabled", "global", "focused"],
      "additionalProperties": false,
      "properties": {
        "globalEnabled": { "type": "boolean" },
        "global": { "$ref": "#/$defs/hotkeyMap" },
        "focused": { "$ref": "#/$defs/hotkeyMap" }
      }
    },
    "timer": {
      "type": "object",
      "required": ["adjustSeconds", "presets", "decisionTimeoutSeconds", "entryGraceSeconds"],
      "additionalProperties": false,
      "properties": {
        "adjustSeconds": { "type": "number", "minimum": 0.1 },
        "presets": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.1 },
          "minItems": 1
        },
        "decisionTimeoutSeconds": { "type": "number", "minimum": 0.1 },
        "entryGraceSeconds": { "type": "number", "minimum": 0.1 }
      }
    },
    "ui": {
      "type": "object",
      "required": ["mode", "showNextCount", "fontScale", "scale"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["minimal", "practice", "review"] },
        "showNextCount": { "type": "integer", "minimum": 0, "maximum": 8 },
        "fontScale": { "type": "number", "minimum": 0.1, "maximum": 2.2 },
        "scale": { "type": "number", "minimum": 0.1, "maximum": 2.2 }
      }
    },
    "data": {
      "type": "object",
      "required": ["buildsPath"],
      "additionalProperties": false,
      "properties": {
        "buildsPath": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "hotkeyMap": {
      "type": "object",
      "required": [
        "choose1",
        "choose2",
        "choose3",
        "reset",
        "jumpForward",
        "jumpBackward",
        "jumpPrevious",
        "jumpNext"
      ],
      "additionalProperties": false,
      "properties": {
        "choose1": { "type": "string", "minLength": 1 },
        "choose2": { "type": "string", "minLength": 1 },
        "choose3": { "type": "string", "minLength": 1 },
        "reset": { "type": "string", "minLength": 1 },
        "jumpForward": { "type": "string", "minLength": 1 },
        "jumpBackward": { "type": "string", "minLength": 1 },
        "jumpPrevious": { "type": "string", "minLength": 1 },
        "jumpNext": { "type": "string", "minLength": 1 },
        "pause": { "type": "string", "minLength": 0 },
        "toggleVisibility": { "type": "string", "minLength": 0 },
        "openViewer": { "type": "string", "minLength": 0 }
      }
    }
  }
}
