      "jumpPrevious": "F7",
      "jumpNext": "F8",
      "pause": "",
      "toggleVisibility": "",
      "openViewer": "F9"
    },
    "focused": {
      "choose1": "F1",
      "choose2": "F2",
      "choose3": "F3",
      "reset": "F4",
      "jumpForward": "F6",
      "jumpBackward": "F5",
      "jumpPrevious": "F7",
      "jumpNext": "F8",
      "pause": "",
      "toggleVisibility": "",
      "openViewer": "F9"
    }
