{
  "window": {
    "width": 560,
    "height": 320,
    "minWidth": 320,
    "minHeight": 220,
    "monitor": 2,
    "x": 10,
    "y": 10,
    "opacity": 0.9,
    "alwaysOnTop": true,
    "transparent": true,
    "frame": false,
    "clickThrough": false
  },
  "hotkeys": {
    "globalEnabled": true,
    "global": {
      "choose1": "F1",
      "choose2": "F2",
      "choose3": "F3",
      "reset": "F4",
      "jumpForward": "F6",
      "jumpBackward": "F5",
      "jumpPrevious": "F7",
      "jumpNext": "F8",
      "pause": "",
      "toggleVisibility": ""
    },
    "focused": {
      "choose1": "F1",
      "choose2": "F2",
      "choose3": "F3",
      "reset": "F4",
      "jumpForward": "F6",
      "jumpBackward": "F5",
      "jumpPrevious": "F7",
      "jumpNext": "F8",
      "pause": "",
      "toggleVisibility": ""
    }
  },
  "timer": {
    "adjustSeconds": 5,
    "presets": [1, 2.5, 5, 10]
  },
  "ui": {
    "mode": "minimal",
    "showNextCount": 2,
    "fontScale": 0.9,
    "scale": 0.9
  },
  "data": {
    "buildsPath": "builds"
  }
}
